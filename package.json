{
  "name": "pdfzero",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based PDF editor. Fork of bevinkatti/pdfzero with a text-preserving export and working Word/text/image export.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
