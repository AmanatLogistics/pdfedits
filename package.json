{
  "name": "pdfedits",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "fixtures": "node tests/fixtures/make-fixtures.mjs",
    "test:coords": "tsx tests/coords.test.mts",
    "test:e2e": "npm run fixtures && playwright test",
    "test": "npm run lint && tsc --noEmit && npm run test:coords && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
